# CharacterBazaarStudio LAN configuration
# Server PC static/LAN IP
SERVER_IP=192.168.1.42

# Django origin used by the frontend's same-origin API proxy.
# Keep the Docker service URL for a local backend; use http(s)://<server-ip>:8000 for a remote backend.
CB_BACKEND_ORIGIN=http://backend:8000

POSTGRES_DB=characterbazaarstudio
POSTGRES_USER=characterbazaarstudio
POSTGRES_PASSWORD=characterbazaarstudio
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=dev-only-change-me-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.42
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.42:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.42:3000

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AI_URL=/ai-api

# AI background provider
# cloudflare = Cloudflare Workers AI (recommended for free testing)
# openai    = OpenAI Images API
# mock      = local placeholder background
# auto      = Cloudflare if configured, then OpenAI, otherwise mock
AI_IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI / FLUX.1 Schnell
# Create these from Cloudflare Dashboard -> AI -> Workers AI -> Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4

# Prompt -> animation director
# auto = Cloudflare when credentials exist, otherwise deterministic local planner
# cloudflare = require Workers AI credentials
# mock = local rule-based test planner
AI_ANIMATION_PROVIDER=auto
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional OpenAI fallback/provider
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
# Browser video renderer
FRONTEND_RENDER_URL=http://frontend:3000
CHROMIUM_PATH=/usr/bin/chromium
RENDER_FPS=15
